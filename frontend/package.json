{
  "name": "nursing-platform-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e:auth": "playwright test --config playwright.config.ts",
    "check:dependencies": "node ./scripts/check-dependencies.mjs",
    "generate:api": "ng-openapi-gen --input ../docs/frontend/design/integration/openapi/development-openapi-2026-09-28.json --output src/app/core/api/generated --services false --promises false --module false --index-file true --enum-style alias --use-temp-dir true",
    "lint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "quality": "npm run check:dependencies && npm run lint && npm run lint:styles && npm test -- --watch=false && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": "22.23.1",
    "npm": "11.6.0"
  },
  "dependencies": {
    "@angular/cdk": "22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/angular-vite": "10.6.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "1.0.5",
    "pg": "^8.23.0",
    "prettier": "^3.8.1",
    "storybook": "10.6.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
